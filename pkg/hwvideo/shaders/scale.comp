// Scales a decoded NV12 picture to RGBA as resample.VideoScaler does with
// an opaque 4:2:0 frame (resample.Plan describes it): every plane averaged
// in blocks of BlockX×BlockY samples, rounded to bytes, then filtered at
// its own resolution to the destination's size (Catmull-Rom widened by the
// scale, or linear), then converted to RGB. Run by hwvk_linux.c in two
// passes: mode 0 averages the blocks into the work buffer, mode 1 filters
// and converts; mode 2 converts a picture of the destination's size.
//
// The picture is in the work buffer as the readback copies it: rows of
// pitch bytes of luma, then rows of pitch bytes of Cb and Cr interleaved.
// The blocks follow it, each plane's rows padded to 4 bytes.
//
// SPIR-V: scale_spv.h, made by `go generate ./pkg/hwvideo` (glslc).

#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(std430, binding = 0) buffer Work {
	uint work[];
};

layout(std430, binding = 1) writeonly buffer Pixels {
	uint pixels[];
};

layout(push_constant) uniform Params {
	uint mode;
	// The destination.
	uint w, h;
	uint fx, fy;
	uint linear;
	// The picture, cropped, and where its first samples are: bytes in the
	// work buffer.
	uint sw, sh;
	uint srcY, srcUV, pitch;
	// Where the blocks start, a multiple of 4.
	uint blocks;
	float gain, black, rv, gu, gv, bu;
} p;

struct Plane {
	uint off, stride, step, width, height;
};

uint byteAt(uint off) {
	return (work[off >> 2] >> ((off & 3u) * 8u)) & 0xffu;
}

uint sampleAt(Plane q, uint x, uint y) {
	return byteAt(q.off + y * q.stride + x * q.step);
}

// source is plane i of the picture: 0 luma, 1 Cb, 2 Cr.
Plane source(uint i) {
	uint cw = (p.sw + 1u) / 2u, ch = (p.sh + 1u) / 2u;
	if (i == 0u) {
		return Plane(p.srcY, p.pitch, 1u, p.sw, p.sh);
	}
	return Plane(p.srcUV + i - 1u, p.pitch, 2u, cw, ch);
}

uint align4(uint v) {
	return (v + 3u) & ~3u;
}

// averaged is plane i of the blocks.
Plane averaged(uint i) {
	uint cw = (p.sw + 1u) / 2u, ch = (p.sh + 1u) / 2u;
	uint bw = (p.sw + p.fx - 1u) / p.fx, bh = (p.sh + p.fy - 1u) / p.fy;
	uint cbw = (cw + p.fx - 1u) / p.fx, cbh = (ch + p.fy - 1u) / p.fy;
	if (i == 0u) {
		return Plane(p.blocks, align4(bw), 1u, bw, bh);
	}
	uint off = p.blocks + align4(bw) * bh + (i - 1u) * align4(cbw) * cbh;
	return Plane(off, align4(cbw), 1u, cbw, cbh);
}

// average writes four blocks of a row of plane z: one word.
void average(uvec3 id) {
	Plane src = source(id.z), dst = averaged(id.z);
	uint by = id.y;
	if (by >= dst.height || id.x * 4u >= dst.width) {
		return;
	}
	uint y0 = by * p.fy, y1 = min(y0 + p.fy, src.height);
	uint word = 0u;
	for (uint k = 0u; k < 4u; k++) {
		uint bx = id.x * 4u + k;
		if (bx >= dst.width) {
			break;
		}
		uint x0 = bx * p.fx, x1 = min(x0 + p.fx, src.width);
		uint sum = 0u;
		for (uint y = y0; y < y1; y++) {
			for (uint x = x0; x < x1; x++) {
				sum += sampleAt(src, x, y);
			}
		}
		uint n = (x1 - x0) * (y1 - y0);
		word |= ((sum + n / 2u) / n) << (8u * k);
	}
	work[(dst.off + by * dst.stride) / 4u + id.x] = word;
}

float catmullRom(float x) {
	x = abs(x);
	if (x < 1.0) {
		return (1.5 * x - 2.5) * x * x + 1.0;
	}
	if (x < 2.0) {
		return ((-0.5 * x + 2.5) * x - 4.0) * x + 2.0;
	}
	return 0.0;
}

// Taps are the samples of a plane n wide that pixel i of d takes, as
// resample's weights and linearWeights have them.
struct Taps {
	int lo, hi;
	float center, stretch, k, norm;
};

Taps taps(uint n, uint d, uint i) {
	Taps t;
	float scale = float(n) / float(d);
	t.center = (float(i) + 0.5) * scale - 0.5;
	t.stretch = max(scale, 1.0);
	t.norm = 1.0;
	t.k = 0.0;
	if (p.linear != 0u) {
		t.lo = min(max(int(floor(t.center)), 0), int(n) - 1);
		t.hi = min(t.lo + 1, int(n) - 1);
		t.k = clamp(t.center - float(t.lo), 0.0, 1.0);
		return t;
	}
	float support = 2.0 * t.stretch;
	t.lo = max(int(floor(t.center - support)) + 1, 0);
	t.hi = min(int(floor(t.center + support)), int(n) - 1);
	float sum = 0.0;
	for (int j = t.lo; j <= t.hi; j++) {
		sum += catmullRom((float(j) - t.center) / t.stretch);
	}
	t.norm = sum;
	return t;
}

float weight(Taps t, int j) {
	if (p.linear != 0u) {
		if (t.hi == t.lo) {
			return 1.0;
		}
		return j == t.lo ? 1.0 - t.k : t.k;
	}
	return catmullRom((float(j) - t.center) / t.stretch) / t.norm;
}

// filtered is plane q at pixel (x, y) of the destination.
float filtered(Plane q, uint x, uint y) {
	Taps tx = taps(q.width, p.w, x), ty = taps(q.height, p.h, y);
	float acc = 0.0;
	for (int j = ty.lo; j <= ty.hi; j++) {
		float row = 0.0;
		for (int i = tx.lo; i <= tx.hi; i++) {
			row += weight(tx, i) * float(sampleAt(q, uint(i), uint(j)));
		}
		acc += weight(ty, j) * row;
	}
	return acc;
}

uint level(float v) {
	return uint(clamp(v, 0.0, 255.0) + 0.5);
}

uint rgba(float y, float cb, float cr) {
	float l = (y - p.black) * p.gain, u = cb - 128.0, v = cr - 128.0;
	uint r = level(l + p.rv * v);
	uint g = level(l - p.gu * u - p.gv * v);
	uint b = level(l + p.bu * u);
	return r | g << 8u | b << 16u | 0xff000000u;
}

void main() {
	uvec3 id = gl_GlobalInvocationID;
	if (p.mode == 0u) {
		average(id);
		return;
	}
	if (id.x >= p.w || id.y >= p.h) {
		return;
	}
	uint out_ = id.y * p.w + id.x;
	if (p.mode == 2u) {
		Plane cb = source(1u), cr = source(2u);
		float y = float(sampleAt(source(0u), id.x, id.y));
		pixels[out_] = rgba(y, float(sampleAt(cb, id.x / 2u, id.y / 2u)), float(sampleAt(cr, id.x / 2u, id.y / 2u)));
		return;
	}
	bool blocked = p.fx > 1u || p.fy > 1u;
	Plane py = blocked ? averaged(0u) : source(0u);
	Plane pb = blocked ? averaged(1u) : source(1u);
	Plane pr = blocked ? averaged(2u) : source(2u);
	pixels[out_] = rgba(filtered(py, id.x, id.y), filtered(pb, id.x, id.y), filtered(pr, id.x, id.y));
}
