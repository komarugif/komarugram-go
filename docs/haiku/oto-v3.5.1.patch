@@ -0,0 +1,67 @@
+// Copyright 2026 The Oto Authors
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+//go:build ignore
+
+// build builds libotohaiku.so, the Media Kit half of oto's Haiku driver, which
+// a program playing sound with oto on Haiku loads from beside itself
+// (driver_haiku.go).
+//
+// On Haiku:
+//
+//	go run build.go -o /path/to/libotohaiku.so
+//
+// From another system, with a C++ compiler for Haiku, such as clang with
+// --target=x86_64-unknown-haiku and a sysroot copied from Haiku:
+//
+//	go run build.go -cxx "clang++ --target=x86_64-unknown-haiku --sysroot=/haiku -fuse-ld=lld" -o libotohaiku.so
+package main
+
+import (
+	"flag"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"runtime"
+	"strings"
+)
+
+func main() {
+	out := flag.String("o", "libotohaiku.so", "the library to write")
+	cxx := flag.String("cxx", "", `the C++ compiler and its flags (default "g++" on Haiku)`)
+	flag.Parse()
+	compiler := strings.Fields(*cxx)
+	if len(compiler) == 0 {
+		if runtime.GOOS != "haiku" {
+			fmt.Fprintln(os.Stderr, "build: give -cxx, a C++ compiler for Haiku")
+			os.Exit(2)
+		}
+		compiler = []string{"g++"}
+	}
+	_, self, _, _ := runtime.Caller(0)
+	dir := filepath.Dir(self)
+	args := append(compiler[1:],
+		"-O2", "-Wall", "-std=c++17", "-fPIC", "-shared",
+		"-o", *out,
+		filepath.Join(dir, "otohaiku.cpp"),
+		"-lmedia", "-lbe",
+	)
+	cmd := exec.Command(compiler[0], args...)
+	cmd.Stdout, cmd.Stderr = os.Stdout, os.Stderr
+	if err := cmd.Run(); err != nil {
+		fmt.Fprintln(os.Stderr, "build:", err)
+		os.Exit(1)
+	}
+}
diff --git a/internal/haiku/otohaiku.cpp b/internal/haiku/otohaiku.cpp
new file mode 100644
index 0000000..7770398
--- /dev/null
+++ b/internal/haiku/otohaiku.cpp
@@ -0,0 +1,109 @@
+// Copyright 2026 The Oto Authors
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+// libotohaiku: oto's output on Haiku, a BSoundPlayer of the Media Kit
+// whose buffers oto's mux fills through a callback into Go.
+
+#include "otohaiku.h"
+
+#include <MediaDefs.h>
+#include <SoundPlayer.h>
+
+#include <stdio.h>
+#include <string.h>
+#include <vector>
+
+namespace {
+
+struct Player {
+	BSoundPlayer *sound = nullptr;
+	oh_read read = nullptr;
+	// scratch takes the float samples of a buffer of another format.
+	std::vector<float> scratch;
+};
+
+// Fill is BSoundPlayer's callback: it asks for one buffer of the format
+// the player was given, which may not be the one asked for.
+void Fill(void *cookie, void *buffer, size_t size, const media_raw_audio_format &format) {
+	Player *p = static_cast<Player *>(cookie);
+	switch (format.format) {
+	case media_raw_audio_format::B_AUDIO_FLOAT:
+		p->read(static_cast<float *>(buffer), size / sizeof(float));
+		return;
+	case media_raw_audio_format::B_AUDIO_SHORT: {
+		size_t n = size / sizeof(int16);
+		p->scratch.resize(n);
+		p->read(p->scratch.data(), n);
+		int16 *out = static_cast<int16 *>(buffer);
+		for (size_t i = 0; i < n; i++) {
+			float v = p->scratch[i];
+			v = v > 1 ? 1 : v < -1 ? -1 : v;
+			out[i] = (int16)(v * 32767);
+		}
+		return;
+	}
+	case media_raw_audio_format::B_AUDIO_INT: {
+		size_t n = size / sizeof(int32);
+		p->scratch.resize(n);
+		p->read(p->scratch.data(), n);
+		int32 *out = static_cast<int32 *>(buffer);
+		for (size_t i = 0; i < n; i++) {
+			double v = p->scratch[i];
+			v = v > 1 ? 1 : v < -1 ? -1 : v;
+			out[i] = (int32)(v * 2147483647.0);
+		}
+		return;
+	}
+	default:
+		memset(buffer, 0, size);
+	}
+}
+
+} // namespace
+
+extern "C" {
+
+int32_t oh_abi(void) { return OH_ABI; }
+
+void *oh_open(int32_t rate, int32_t channels, int32_t buffer_bytes, oh_read read, char *err, size_t errlen) {
+	media_raw_audio_format format = media_raw_audio_format::wildcard;
+	format.frame_rate = rate;
+	format.channel_count = channels;
+	format.format = media_raw_audio_format::B_AUDIO_FLOAT;
+	format.byte_order = B_MEDIA_HOST_ENDIAN;
+	if (buffer_bytes > 0)
+		format.buffer_size = buffer_bytes;
+
+	Player *p = new Player;
+	p->read = read;
+	p->sound = new BSoundPlayer(&format, "oto", Fill, nullptr, p);
+	status_t st = p->sound->InitCheck();
+	if (st != B_OK) {
+		snprintf(err, errlen, "BSoundPlayer: %s", strerror(st));
+		delete p->sound;
+		delete p;
+		return nullptr;
+	}
+	p->sound->SetHasData(true);
+	return p;
+}
+
+int32_t oh_start(void *p) { return static_cast<Player *>(p)->sound->Start(); }
+
+int32_t oh_stop(void *p) {
+	static_cast<Player *>(p)->sound->Stop();
+	return B_OK;
+}
+
+} // extern "C"
diff --git a/internal/haiku/otohaiku.h b/internal/haiku/otohaiku.h
new file mode 100644
