+//go:build haiku
+
+package oto
+
+// #include <stddef.h>
+import "C"
+
+import (
+	"unsafe"
+
+	"github.com/ebitengine/oto/v3/internal/mux"
+)
+
+// theMux is the mux of the one context, which the player's callback reads.
+// The callback is in a file of its own: cgo allows a file with //export
+// only declarations in its preamble.
+var theMux *mux.Mux
+
+//export oto_haikuRead
+func oto_haikuRead(buf *C.float, n C.size_t) {
+	theMux.ReadFloat32s(unsafe.Slice((*float32)(unsafe.Pointer(buf)), n))
+}
