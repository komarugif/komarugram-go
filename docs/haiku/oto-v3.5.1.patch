+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+//go:build haiku
+
+package oto
+
+// The Haiku driver: a BSoundPlayer of the Media Kit, in C++, in
+// libotohaiku (internal/haiku), which Go's linker cannot take into a
+// Haiku program; it is built apart and loaded with dlopen. The player's
+// thread asks for each buffer through a callback, which the mux fills.
+
+/*
+#cgo CFLAGS: -Werror
+
+#include <dlfcn.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include "internal/haiku/otohaiku.h"
+
+static void *oh_lib;
+
+#define OH_FUNCS(X) \
+	X(int32_t, oh_abi, (void), ()) \
+	X(void *, oh_open, (int32_t a, int32_t b, int32_t c, oh_read d, char *e, size_t f), (a, b, c, d, e, f)) \
+	X(int32_t, oh_start, (void *a), (a)) \
+	X(int32_t, oh_stop, (void *a), (a))
+
+#define OH_PTR(ret, name, params, args) static ret (*name##_ptr) params;
+OH_FUNCS(OH_PTR)
+#define OH_CALL(ret, name, params, args) static ret p##name params { return name##_ptr args; }
+OH_FUNCS(OH_CALL)
+
+// oh_load opens the library at path and finds its functions. It returns
+// NULL, or what went wrong.
+static const char *oh_load(const char *path) {
+	oh_lib = dlopen(path, RTLD_NOW | RTLD_LOCAL);
+	if (oh_lib == NULL)
+		return dlerror();
+#define OH_SYM(ret, name, params, args) \
+	if ((name##_ptr = (ret (*) params)dlsym(oh_lib, #name)) == NULL) \
+		return "missing " #name;
+	OH_FUNCS(OH_SYM)
+	return NULL;
+}
+
+void oto_haikuRead(float *buf, size_t n);
+
+static void *oh_open_go(int32_t rate, int32_t channels, int32_t buffer_bytes, char *err, size_t errlen) {
+	return poh_open(rate, channels, buffer_bytes, oto_haikuRead, err, errlen);
+}
+*/
+import "C"
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"unsafe"
+
+	"github.com/ebitengine/oto/v3/internal/mux"
+)
+
+type context struct {
+	mux    *mux.Mux
+	player unsafe.Pointer
+}
+
+func newContext(sampleRate int, channelCount int, format mux.Format, bufferSizeInBytes int, _ string) (*context, chan struct{}, error) {
+	if err := loadHaiku(); err != nil {
+		return nil, nil, err
+	}
+	c := &context{mux: mux.New(sampleRate, channelCount, format)}
+	theMux = c.mux
+	// The buffer the caller asked for is of its format; the player's
+	// samples are float32.
+	floatBytes := 0
+	if bufferSizeInBytes > 0 {
+		floatBytes = bufferSizeInBytes / format.ByteLength() * 4
+	}
+	var msg [256]C.char
+	c.player = C.oh_open_go(C.int32_t(sampleRate), C.int32_t(channelCount), C.int32_t(floatBytes), &msg[0], C.size_t(len(msg)))
+	if c.player == nil {
+		return nil, nil, fmt.Errorf("oto: %s", C.GoString(&msg[0]))
+	}
+	if st := C.poh_start(c.player); st != 0 {
+		return nil, nil, fmt.Errorf("oto: BSoundPlayer.Start: %d", st)
+	}
+	ready := make(chan struct{})
+	close(ready)
+	return c, ready, nil
+}
+
+// loadHaiku loads libotohaiku from $OTO_HAIKU_LIB, from beside the
+// program or from lib beside it, or where Haiku looks for libraries.
+func loadHaiku() error {
+	var candidates, tried []string
+	if p := os.Getenv("OTO_HAIKU_LIB"); p != "" {
+		candidates = append(candidates, p)
+	}
+	if exe, err := os.Executable(); err == nil {
+		dir := filepath.Dir(exe)
+		candidates = append(candidates, filepath.Join(dir, "libotohaiku.so"), filepath.Join(dir, "lib", "libotohaiku.so"))
+	}
+	candidates = append(candidates, "libotohaiku.so")
+	for _, p := range candidates {
+		cp := C.CString(p)
+		msg := C.oh_load(cp)
+		C.free(unsafe.Pointer(cp))
+		if msg == nil {
+			if abi := C.poh_abi(); abi != C.OH_ABI {
+				return fmt.Errorf("oto: libotohaiku is of interface %d, not %d", abi, C.OH_ABI)
+			}
+			return nil
+		}
+		tried = append(tried, C.GoString(msg))
+	}
+	return fmt.Errorf("oto: cannot load libotohaiku: %s", strings.Join(tried, "; "))
+}
+
+func (c *context) Suspend() error {
+	if st := C.poh_stop(c.player); st != 0 {
+		return fmt.Errorf("oto: BSoundPlayer.Stop: %d", st)
+	}
+	return nil
+}
+
+func (c *context) Resume() error {
+	if st := C.poh_start(c.player); st != 0 {
+		return fmt.Errorf("oto: BSoundPlayer.Start: %d", st)
+	}
+	return nil
+}
+
+func (c *context) Err() error {
+	return nil
+}
