diff -ruN a/unix/mprotect_haiku.go b/unix/mprotect_haiku.go
--- a/unix/mprotect_haiku.go
+++ b/unix/mprotect_haiku.go
@@ -0,0 +1,24 @@
+// Experimental: mprotect for Haiku, missing from the go-haiku fork's x/sys.
+
+//go:build haiku
+
+package unix
+
+import "unsafe"
+
+//go:cgo_import_dynamic libc_Mprotect mprotect "libroot.so"
+//go:linkname libc_Mprotect libc_Mprotect
+
+var libc_Mprotect syscallFunc
+
+func Mprotect(b []byte, prot int) (err error) {
+	var p unsafe.Pointer
+	if len(b) > 0 {
+		p = unsafe.Pointer(&b[0])
+	}
+	_, _, e1 := sysvicall6(uintptr(unsafe.Pointer(&libc_Mprotect)), 3, uintptr(p), uintptr(len(b)), uintptr(prot), 0, 0, 0)
+	if e1 != 0 {
+		err = errnoErr(e1)
+	}
+	return
+}
